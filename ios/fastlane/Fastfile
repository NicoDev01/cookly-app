# iOS-Release ohne Mac: läuft in .github/workflows/ios-testflight.yml auf einem
# GitHub-macOS-Runner. Anleitung und benötigte Secrets: docs/IOS_CI_BUILD.md
default_platform(:ios)

PROJECT = File.expand_path("../App/App.xcodeproj", __dir__)
TEAM_ID = "X8LYFSW6LP"
TARGETS = {
  "com.cookly.recipe" => "App",
  "com.cookly.recipe.CooklyShare" => "CooklyShare",
}.freeze

platform :ios do
  desc "Baut den Release-Build, signiert ihn und lädt ihn nach TestFlight"
  lane :testflight_release do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
    )

    # Ohne Apple-Zwischenzertifikat gilt die Distribution-Identität als ungültig.
    wwdr = File.join(ENV.fetch("RUNNER_TEMP"), "AppleWWDRCAG3.cer")
    sh("curl", "-sSfL", "-o", wwdr, "https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer")
    import_certificate(certificate_path: wwdr, keychain_name: "fastlane_tmp_keychain", keychain_password: "")
    import_certificate(
      certificate_path: ENV.fetch("DIST_CERT_P12_PATH"),
      certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
    )

    # Holt die App-Store-Profile (oder legt sie an), passend zum importierten Zertifikat.
    profiles = TARGETS.to_h do |bundle_id, target|
      get_provisioning_profile(api_key: api_key, app_identifier: bundle_id, team_id: TEAM_ID)
      name = lane_context[SharedValues::SIGH_NAME]
      update_code_signing_settings(
        path: PROJECT,
        targets: [target],
        build_configurations: ["Release"],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: name,
      )
      [bundle_id, name]
    end

    build_number = ENV["BUILD_NUMBER"].to_s.strip
    build_app(
      project: PROJECT,
      scheme: "App",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: { provisioningProfiles: profiles },
      xcargs: build_number.empty? ? nil : "CURRENT_PROJECT_VERSION=#{build_number}",
      output_directory: File.join(ENV.fetch("RUNNER_TEMP"), "build"),
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
