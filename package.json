{
  "name": "cookly-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test utils/*.test.mjs components/addRecipeModal/*.test.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:check": "tsc --noEmit && npm run fonts:check && vite build",
    "build:android": "npm run fonts:check && vite build --mode production && node scripts/sync-android.js",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "fonts:check": "node scripts/check-fonts.mjs",
    "lint": "eslint .",
    "lint:all": "npm run lint && npm run knip && npm run jscpd",
    "knip": "knip --include files,dependencies,unlisted",
    "knip:all": "knip",
    "knip:fix": "knip --fix",
    "jscpd": "jscpd",
    "ast-grep": "ast-grep scan",
    "ast-grep:fix": "ast-grep scan --fix",
    "preview": "vite preview",
    "admin": "node --env-file-if-exists=.env.admin.local admin-dashboard/server.mjs",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "release:build": "node scripts/version-upgrade.js build",
    "release:patch": "node scripts/version-upgrade.js patch",
    "release:minor": "node scripts/version-upgrade.js minor",
    "release:major": "node scripts/version-upgrade.js major"
  },
  "dependencies": {
    "@auth/core": "^0.37.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@convex-dev/auth": "^0.0.91",
    "@google/genai": "^1.52.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@revenuecat/purchases-capacitor": "^13.2.2",
    "@sentry/react": "10.65.0",
    "@supernotes/capacitor-send-intent": "^7.0.0",
    "blurhash": "^2.0.5",
    "capacitor-lottie-splash-screen": "^7.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.3",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.562.0",
    "posthog-js": "^1.404.0",
    "react": "^19.2.0",
    "react-blurhash": "^0.3.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.1",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.4.0",
    "use-debounce": "^10.1.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.40.5",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.39.1",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jscpd": "^4.0.8",
    "knip": "^5.82.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
